# Copy this file to .env and add your private provider values.
# Values are read by server.py when it starts.

APP_ENV=development
APP_SECRET=local-development-only-change-me

# SMTP verification and password reset email
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Reserved for the future PostgreSQL deployment.
# The current local app still uses tictactoe.sqlite3.
DATABASE_URL=

HOST=127.0.0.1
PORT=8000
