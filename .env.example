# Copy this file to .env and add your private provider values.
# Values are read by game_logic.py when the app starts.

APP_ENV=development
APP_SECRET=local-development-only-change-me

# SMTP verification and password reset email
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Neon PostgreSQL pooled URL for local development and Vercel.
DATABASE_URL=
